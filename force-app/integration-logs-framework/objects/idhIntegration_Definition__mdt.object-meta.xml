<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Defines an integration in a neutral, org-agnostic way.</description>
    <fields>
        <fullName>IntegrationCode__c</fullName>
        <description>Stable, unique integration code used by emitters.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Integration Code</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Direction__c</fullName>
        <description>Direction of the integration flow.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Direction</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Inbound</fullName>
                    <default>false</default>
                    <label>Inbound</label>
                </value>
                <value>
                    <fullName>Outbound</fullName>
                    <default>false</default>
                    <label>Outbound</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Transport__c</fullName>
        <description>Transport used by the integration (HTTP, Event, File, etc.).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Transport</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CorrelationStrategy__c</fullName>
        <description>How correlation IDs are generated/propagated.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Correlation Strategy</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Enabled__c</fullName>
        <description>Flag indicating whether this integration is enabled.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Enabled</label>
        <type>Checkbox</type>
        <defaultValue>true</defaultValue>
    </fields>
    <label>idh Integration Definition</label>
    <pluralLabel>idh Integration Definitions</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
